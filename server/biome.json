{
	"extends": "//",
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**", "!!src/db/drizzle", "!!dist"]
	},
	"javascript": {
		"assist": {
			"enabled": true
		},
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "none"
		}
	},
	"linter": {
		"domains": {
			"project": "recommended"
		},
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"style": {
				"noNestedTernary": "error",
				"noProcessEnv": "error",
				"useBlockStatements": "off",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case", "export"],
						"strictCase": false
					}
				},
				"useImportType": "error",
				"useTrimStartEnd": "error"
			},
			"suspicious": {
				"noConsole": "warn",
				"noExplicitAny": "off",
				"noIrregularWhitespace": "error"
			}
		}
	},
	"root": false
}
