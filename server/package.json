{
	"dependencies": {
		"@ai-sdk/mcp": "catalog:",
		"@ai-sdk/otel": "catalog:",
		"@better-auth/drizzle-adapter": "^1.7.18",
		"@chat-app/shared": "workspace:*",
		"@hono/zod-openapi": "catalog:",
		"@langfuse/otel": "^6.1.1",
		"@langfuse/tracing": "^6.1.1",
		"@opentelemetry/api": "~1.10.0",
		"@opentelemetry/sdk-node": "^0.301.0",
		"@scalar/hono-api-reference": "^0.12.18",
		"@sentry/bun": "^11.11.0",
		"@sentry/hono": "^11.11.0",
		"ai": "catalog:",
		"better-auth": "^1.7.18",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "catalog:",
		"hono-pino": "^0.10.3",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"unpdf": "^2.1.0",
		"zod": "catalog:"
	},
	"description": "AI-powered module using vercel AI SDK",
	"devDependencies": {
		"@types/bun": "1.4.4",
		"@types/node": "catalog:",
		"bun-types": "1.4.4",
		"drizzle-kit": "1.0.0-rc.5",
		"postgres": "^4.1.0"
	},
	"engines": {
		"bun": ">=1.4.4"
	},
	"keywords": [
		"deepseek",
		"hono",
		"scalar",
		"AI"
	],
	"module": "src/index.ts",
	"name": "@chat-app/server",
	"scripts": {
		"build": "bun scripts/build.ts",
		"db:check": "drizzle-kit check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "NODE_ENV=development bun --check --env-file ../.env --env-file .env --env-file .env.local --watch --preload ./src/instrumentation.ts src/index.ts",
		"start": "bun --preload ./src/instrumentation.ts src/index.ts",
		"test": "bun test --check --preload ./src/test/setup-env.ts --parallel=1",
		"test:integration": "RUN_DATABASE_TESTS=1 bun test --check --preload ./src/test/setup-env.ts --parallel=1 src/services/conversation.integration.test.ts src/services/usage.integration.test.ts",
		"test:live": "bun --env-file ../.env scripts/live-smoke.ts",
		"typecheck": "bun check --project tsconfig.json",
		"typecheck:tsc": "bunx --no-install --package typescript tsc --noEmit --project tsconfig.json"
	},
	"type": "module",
	"version": "1.0.0"
}
