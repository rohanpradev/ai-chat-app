{
  "name": "@chat-app/server",
  "type": "module",
  "version": "1.0.0",
  "description": "AI-powered module using vercel AI SDK",
  "keywords": [
    "deepseek",
    "hono",
    "scalar",
    "AI"
  ],
  "module": "src/index.ts",
  "scripts": {
    "build": "bun build src/index.ts --target=bun --packages=external --outdir dist --root src",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "bun test --preload ./src/test/setup-env.ts --parallel=1",
    "typecheck": "bun run typecheck:tsc",
    "typecheck:tsc": "bunx --no-install --package typescript tsc --noEmit --project tsconfig.json"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.50",
    "@ai-sdk/otel": "^1.0.83",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@chat-app/shared": "workspace:*",
    "@hono/zod-openapi": "catalog:",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@scalar/hono-api-reference": "^0.11.16",
    "@sentry/bun": "^10.71.0",
    "ai": "catalog:",
    "better-auth": "^1.7.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "catalog:",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "unpdf": "^1.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "catalog:",
    "bun-types": "^1.4.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "postgres": "^3.4.9"
  }
}
