# Server environment variables template
# Copy this file to .env.docker and update ALL values below
# All values are REQUIRED unless marked as optional

# Server configuration
SERVER_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Database configuration - ALL REQUIRED
DB_PASSWORD=your_db_password_here
DB_USER=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=chatapp
DB_URL=postgres://postgres:your_db_password_here@db:5432/chatapp

# Redis configuration - REQUIRED
REDIS_URL=redis://:redis_password@redis:6379

# OpenAI - REQUIRED for AI features
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=1000000
EMBEDDING_DAILY_TOKEN_LIMIT=1000000
EMBEDDING_STORAGE_BYTE_LIMIT=104857600
SERPER_API_KEY=your_serper_api_key_here

# Langfuse - OPTIONAL for AI observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry - OPTIONAL error monitoring and tracing
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Better Auth - REQUIRED (Generate a secure 32+ character string)
BETTER_AUTH_SECRET=your_better_auth_secret_32_chars_minimum_here
# Optional override for OAuth redirect origin. Defaults to CLIENT_URL.
BETTER_AUTH_URL=

# GitHub OAuth - REQUIRED for the GitHub provider
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Client URL for CORS - REQUIRED
CLIENT_URL=http://localhost

# API configuration - REQUIRED
BASE_API_SLUG=api

# Docker/Traefik configuration - ALL REQUIRED
DOMAIN=localhost
TRAEFIK_LOG_LEVEL=INFO

# Docker image defaults for local Compose builds.
# Override to DHI or digest-pinned images for production.
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.5.0
BUN_DEV_IMAGE=oven/bun:1.4.4-alpine
BUN_RUNTIME_IMAGE=oven/bun:1.4.4-alpine
NGINX_IMAGE=nginx:1.31.8-alpine3.24@sha256:1ef7ca94d7879df82421428ce13bd1eaa412404953859cf7a5b6512c25e67a60
TRAEFIK_IMAGE=traefik:v3.7.16@sha256:c8a121e4bb1347e8fd52657fab12f2cb70b68f8a018895e2068f92c9e519b9c2
POSTGRES_IMAGE=pgvector/pgvector:0.8.7-pg18-trixie@sha256:9d9c930220cb9bf2f956d10a8f909cf9973d9672ca0278aef2c1e6facccad2e0
REDIS_IMAGE=redis:8.10.0-trixie

# Monitoring configuration - REQUIRED if using monitoring profile
GRAFANA_PASSWORD=admin123

# Vercel AI Gateway key for all model calls (server only)
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
