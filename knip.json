{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	},
	"ignoreIssues": {
		"client/src/components/ai-elements/**": [
			"exports",
			"types",
			"nsExports",
			"nsTypes",
			"duplicates",
			"enumMembers",
			"namespaceMembers"
		],
		"client/src/components/ui/**": [
			"exports",
			"types",
			"nsExports",
			"nsTypes",
			"duplicates",
			"enumMembers",
			"namespaceMembers"
		],
		"client/src/utils/query-key.ts": ["exports"],
		"scripts/check-supply-chain.mjs": ["files"],
		"scripts/report-client-bundle-size.mjs": ["files"],
		"server/src/db/schema.ts": ["exports", "types"],
		"server/src/test/setup-env.ts": ["files"]
	},
	"rules": {
		"binaries": "error",
		"catalog": "error",
		"dependencies": "error",
		"devDependencies": "warn",
		"duplicates": "warn",
		"enumMembers": "off",
		"exports": "warn",
		"files": "error",
		"namespaceMembers": "off",
		"nsExports": "warn",
		"nsTypes": "warn",
		"optionalPeerDependencies": "warn",
		"types": "warn",
		"unlisted": "error",
		"unresolved": "error"
	},
	"treatConfigHintsAsErrors": true,
	"workspaces": {
		".": {
			"entry": [
				"scripts/check-helm-runtime-config.mjs",
				"scripts/check-k8s-gateway.test.mjs",
				"scripts/check-toolchain.test.mjs",
				"scripts/ensure-kubectl.mjs",
				"scripts/kubectl.test.mjs",
				"scripts/local-dev.mjs"
			],
			"ignoreBinaries": ["helm", "kubectl", "make"]
		},
		"client": {
			"ignoreBinaries": ["vite!"],
			"ignoreFiles": ["src/lib/browser-node-shims/diagnostics-channel.ts"]
		},
		"server": {
			"drizzle": {
				"config": []
			},
			"entry": ["drizzle.config.ts", "src/instrumentation.ts"]
		}
	}
}
