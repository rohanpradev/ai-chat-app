{
  "name": "@chat-app/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "bun run typecheck && vite build",
    "build:report": "bun run build && bun ../scripts/report-client-bundle-size.mjs",
    "serve": "vite preview",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:coverage": "node ./node_modules/vitest/vitest.mjs run --coverage --coverage.provider=v8 --coverage.reporter=lcov --coverage.reporter=text-summary",
    "typecheck": "bun check --project tsconfig.json",
    "typecheck:tsc": "bunx --no-install --package typescript tsc --noEmit --project tsconfig.json"
  },
