{
	"author": {
		"name": "Rohan Pradev"
	},
	"catalog": {
		"@ai-sdk/mcp": "2.0.93",
		"@ai-sdk/otel": "1.0.166",
		"@ai-sdk/react": "4.0.170",
		"@hono/zod-openapi": "^1.6.3",
		"@hono/zod-validator": "^0.9.1",
		"@types/node": "^26.6.6",
		"ai": "7.0.166",
		"hono": "^4.13.17",
		"zod": "^4.6.7"
	},
	"description": "A chat application built with Bun, React, and Zod.",
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "^1.65.0",
		"knip": "^6.44.2",
		"rimraf": "^6.1.4",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.4",
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"name": "chat-app",
	"overrides": {
		"@babel/core": "7.29.7",
		"@grpc/grpc-js": "1.14.6",
		"brace-expansion": "5.0.12",
		"dompurify": "3.4.17",
		"katex": "0.18.11",
		"mermaid": "11.17.2",
		"uuid": "14.0.3"
	},
	"packageManager": "bun@1.4.4",
	"private": true,
	"scripts": {
		"app:health": "make health",
		"app:start": "make start",
		"audit": "bun audit",
		"build": "bun run build:client && bun run build:server",
		"build:client": "bun run --filter @chat-app/client build",
		"build:report": "bun run --filter @chat-app/client build:report",
		"build:server": "bun run --filter @chat-app/server build",
		"check": "bun run check:toolchain && bun run lint && bun run typecheck && bun run test && bun run check:makefile",
		"check:ci": "bun run security:check && bun run knip && bun run check:migrations && bun run check && bun run build && bun scripts/report-client-bundle-size.mjs && bun run check:deploy",
		"check:client-container": "bun scripts/check-client-container.mjs",
		"check:deploy": "bun scripts/check-deployments.mjs",
		"check:k8s": "node scripts/check-k8s-runtime.mjs",
		"check:k8s-versions": "bun scripts/check-k8s-versions.mjs",
		"check:makefile": "bun --no-env-file test scripts/makefile.test.mjs",
		"check:migrate-container": "bun scripts/check-migrate-container.mjs",
		"check:migrations": "bun scripts/check-migrations.mjs",
		"check:server-container": "bun scripts/check-server-container.mjs",
		"check:toolchain": "bun scripts/check-toolchain.mjs",
		"clean": "rimraf node_modules client/node_modules server/node_modules shared/node_modules",
		"dev": "bun run --filter '*' dev",
		"format": "biome format . --write",
		"k8s:deploy": "bash scripts/deploy-k8s.sh",
		"k8s:prepare": "bash scripts/ensure-k8s-secrets.sh",
		"k8s:status": "make k8s-status",
		"k8s:validate": "bun run check:deploy",
		"knip": "knip",
		"knip:production": "knip --production",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"security:check": "bun run audit && bun run security:supply-chain",
		"security:supply-chain": "bun scripts/check-supply-chain.mjs",
		"start": "bun run dev",
		"test": "bun run --filter '*' test",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"test:integration": "bun run --filter @chat-app/server test:integration",
		"test:live": "bun run --filter @chat-app/server test:live",
		"typecheck": "bun run --filter '*' typecheck",
		"typecheck:tsc": "bun run --filter '*' typecheck:tsc"
	},
	"type": "module",
	"workspaces": [
		"server",
		"client",
		"shared"
	]
}
