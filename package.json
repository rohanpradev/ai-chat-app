{
	"author": {
		"name": "Rohan Pradev"
	},
	"catalog": {
		"@hono/zod-openapi": "^1.5.1",
		"@hono/zod-validator": "^0.9.0",
		"@types/node": "^26.1.1",
		"ai": "^7.0.31",
		"hono": "^4.12.31",
		"zod": "^4.4.3"
	},
	"description": "A chat application built with Bun, React, and Zod.",
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@playwright/test": "^1.61.1",
		"knip": "^6.27.0",
		"rimraf": "^6.1.3",
		"typescript": "7.0.2"
	},
	"name": "chat-app",
	"overrides": {
		"@babel/core": "7.29.7",
		"@grpc/grpc-js": "1.14.4",
		"@opentelemetry/core": "2.8.0",
		"@protobufjs/utf8": "1.1.1",
		"brace-expansion": "5.0.8",
		"dompurify": "3.4.12",
		"esbuild": "0.25.12",
		"linkify-it": "5.0.2",
		"mermaid": "11.15.0",
		"postcss": "8.5.22",
		"protobufjs": "8.7.1",
		"uuid": "11.1.1"
	},
	"packageManager": "bun@1.3.14",
	"private": true,
	"scripts": {
		"app:health": "make health",
		"app:start": "make start",
		"audit": "bun audit",
		"build": "bun run build:client && bun run build:server",
		"build:client": "bun run --filter @chat-app/client build",
		"build:report": "bun run --filter @chat-app/client build:report",
		"build:server": "bun run --filter @chat-app/server build",
		"check": "bun run lint && bun run typecheck && bun run test",
		"check:ci": "bun run security:check && bun run knip && bun run check:migrations && bun run check && bun run build && bun run check:deploy",
		"check:deploy": "bun scripts/check-deployments.mjs",
		"check:migrations": "bun scripts/check-migrations.mjs",
		"clean": "rimraf node_modules bun.lock",
		"dev": "bun run --filter '*' dev",
		"format": "biome format . --write",
		"k8s:deploy": "bash scripts/deploy-k8s.sh",
		"k8s:prepare": "bash scripts/ensure-k8s-secrets.sh",
		"k8s:status": "kubectl get all -n default",
		"k8s:validate": "bun run check:deploy",
		"knip": "knip",
		"knip:production": "knip --production",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"security:check": "bun run audit && bun run security:supply-chain",
		"security:supply-chain": "bun scripts/check-supply-chain.mjs",
		"start": "bun run dev",
		"test": "bun run --filter '*' test",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"typecheck": "bun run typecheck:tsc",
		"typecheck:tsc": "bun run --filter '*' typecheck:tsc"
	},
	"type": "module",
	"workspaces": [
		"server",
		"client",
		"shared"
	]
}
