# ============================================
# REQUIRED: Update these 3 values to get started
# ============================================

# OpenAI API Key (Get from platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_TOKEN_LIMIT=1000000
EMBEDDING_DAILY_TOKEN_LIMIT=1000000
EMBEDDING_STORAGE_BYTE_LIMIT=104857600

# Optional: comma-separated additional model ids to show in the selector
# Useful for account-specific/private models if the live model catalog does not list them yet.
OPENAI_MODEL_OVERRIDES=

# Better Auth Secret (Generate: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_secure_better_auth_secret_here_min_32_characters

# Optional: override the public origin Better Auth uses for redirects.
# Defaults to CLIENT_URL when empty.
BETTER_AUTH_URL=

# GitHub OAuth (required for "Continue with GitHub")
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database Password (Change for production)
DB_PASSWORD=postgres

# ============================================
# Optional: Update for production or tools
# ============================================

# Hostname configuration for local TLS and routing
DOMAIN=localhost

# Web Search Tool (Get free API key from serper.dev - optional)
SERPER_API_KEY=

# Optional: signs AI SDK tool approval responses to prevent replay/tampering.
# Generate: openssl rand -base64 32
AI_TOOL_APPROVAL_SECRET=

# Langfuse AI Observability (Optional - hosted)
# Create a project in Langfuse Cloud and paste your API keys here, then 'make restart'
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry Error Monitoring (Optional)
# Runtime server DSN. Keep empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# Browser Sentry DSN and sampling. VITE_ values are embedded at client build time.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0.1

# Required only when uploading production browser source maps during client builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ============================================
# Defaults: No need to change for local dev
# ============================================

SERVER_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

DB_USER=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=chatapp
DB_URL=postgres://postgres:postgres@db:5432/chatapp

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_AUTH=redis_password
REDIS_URL=redis://:redis_password@redis:6379

CLIENT_URL=https://localhost
BASE_API_SLUG=api

VITE_API_URL=/api
VITE_DEV_MODE=true
VITE_APP_NAME="Chat App"
VITE_APP_VERSION=1.0.0

TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=change-me

# Docker image defaults use public upstream images for local development.
# The socket proxy keeps Traefik off the host Docker socket; do not bypass it in shared environments.
# Production can override these to reviewed Docker Hardened Images or digest-pinned images.
DOCKER_SOCKET_PROXY_IMAGE=ghcr.io/tecnativa/docker-socket-proxy:v0.4.2
BUN_DEV_IMAGE=oven/bun:1.3.14-alpine
BUN_RUNTIME_IMAGE=oven/bun:1.3.14-alpine
NGINX_IMAGE=nginx:1.31.3-alpine3.24
TRAEFIK_IMAGE=traefik:v3.7.9
POSTGRES_IMAGE=pgvector/pgvector:0.8.5-pg18-trixie
REDIS_IMAGE=redis:8.8.1-trixie

# Optional Docker Hardened Images credentials used by Kubernetes helper scripts.
DHI_USERNAME=
DHI_PASSWORD=

# Kubernetes Gateway options (optional)
# Enable this if you install Traefik and want hostname routing in Kubernetes.
K8S_GATEWAY_ENABLED=false
K8S_APP_HOSTNAME=app.docker.localhost
K8S_APP_NAMESPACE=default
K8S_TRAEFIK_DASHBOARD_HOSTNAME=traefik.docker.localhost
K8S_TRAEFIK_NAMESPACE=traefik
K8S_TRAEFIK_GATEWAY_NAME=traefik-gateway
TRAEFIK_CHART_REF=oci://ghcr.io/traefik/helm/traefik
# Traefik 3.7 documents Gateway API 1.6.1 support; keep these paired.
TRAEFIK_CHART_VERSION=41.1.0
GATEWAY_API_VERSION=v1.6.1
TRAEFIK_IMAGE_REGISTRY=dhi.io
TRAEFIK_IMAGE_REPOSITORY=traefik
TRAEFIK_IMAGE_TAG=3.7.9-debian13-dev
TRAEFIK_IMAGE_DIGEST=
TRAEFIK_VERSION_OVERRIDE=3.7.9
